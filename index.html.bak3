<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio | Raksyz</title>
    <link rel="icon" type="image/png" href="logo.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Supabase JS Library -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    
    <style>
        :root {
            --primary: #6C63FF;
            --secondary: #E94560;
            --bg: #0a0a1a;
            --text: #ffffff;
            --glass-bg: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(108, 99, 255, 0.2);
        }

        /* Light Mode */
        body.light-mode {
            --bg: #f4f6f8;
            --text: #1a1a2e;
            --glass-bg: rgba(255, 255, 255, 0.7);
            --glass-border: rgba(108, 99, 255, 0.4);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
        
        body { background-color: var(--bg); color: var(--text); overflow-x: hidden; line-height: 1.6; transition: background-color 0.4s ease, color 0.4s ease; }

        body.light-mode #hero p, body.light-mode .project-card p, body.light-mode .social-info p, body.light-mode footer { color: #4a4a68; }
        body.light-mode .tech-tags span { background: rgba(108, 99, 255, 0.15); color: var(--primary); font-weight: 600; }
        body.light-mode input, body.light-mode textarea { background: rgba(255, 255, 255, 0.9); color: var(--text); border-color: rgba(108, 99, 255, 0.3); }
        body.light-mode .iframe-wrapper { background: rgba(0, 0, 0, 0.05); }
        body.light-mode .iframe-fallback { color: rgba(0, 0, 0, 0.5); }
        body.light-mode nav.scrolled { background: rgba(244, 246, 248, 0.85); }
        body.light-mode .nav-links { background: rgba(244, 246, 248, 0.95); }

        #particles { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1; pointer-events: none; }

        nav { position: fixed; top: 0; width: 100%; padding: 20px 5%; display: flex; justify-content: space-between; align-items: center; z-index: 100; transition: background 0.3s ease, padding 0.3s ease; }
        nav.scrolled { background: rgba(10, 10, 26, 0.8); backdrop-filter: blur(10px); padding: 15px 5%; border-bottom: 1px solid var(--glass-border); }
        .logo { font-size: 1.5rem; font-weight: 700; color: var(--text); text-decoration: none; }
        .logo span { color: var(--primary); }
        .nav-links { display: flex; gap: 30px; list-style: none; }
        .nav-links a { color: var(--text); text-decoration: none; font-weight: 500; transition: color 0.3s; }
        .nav-links a:hover { color: var(--primary); }
        .theme-toggle { background: transparent; border: none; color: var(--text); font-size: 1.4rem; cursor: pointer; transition: color 0.3s, transform 0.3s; display: flex; align-items: center; justify-content: center; }
        .theme-toggle:hover { color: var(--primary); transform: scale(1.1); }
        .hamburger { display: none; cursor: pointer; font-size: 1.5rem; color: var(--text); }
        
        .glass { background: var(--glass-bg); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid var(--glass-border); border-radius: 16px; }
        .glass-card { transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.4s ease; }
        .glass-card:hover { transform: scale(1.05); box-shadow: 0 10px 30px rgba(108, 99, 255, 0.2); }
        
        .reveal { transition: opacity 0.8s ease-out, transform 0.8s ease-out; }
        .reveal.start { opacity: 0; transform: translateY(40px); }

        section { padding: 100px 10%; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; }
        .section-title { font-size: 2.5rem; margin-bottom: 50px; text-align: center; font-weight: 700; }
        .section-title span { color: var(--primary); }
        
        .btn { display: inline-block; padding: 12px 28px; background: var(--primary); color: white; text-decoration: none; border-radius: 8px; font-weight: 600; transition: transform 0.3s, background 0.3s; border: none; cursor: pointer; }
        .btn:hover { transform: translateY(-3px); background: #5a52d5; }
        .btn-outline { background: transparent; border: 2px solid var(--primary); color: var(--text); }
        .btn-outline:hover { background: var(--primary); color: white; transform: translateY(-3px); }
        .btn-danger { background: var(--secondary); margin-top: 0; }
        .btn-danger:hover { background: #d03d55; }

        #hero { align-items: flex-start; text-align: left; }
        #hero h1 { font-size: 4rem; margin-bottom: 20px; line-height: 1.2; }
        #hero h1 span { background: linear-gradient(45deg, var(--primary), var(--secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        #hero p { font-size: 1.2rem; margin-bottom: 40px; color: #aaa; max-width: 600px; }
        
        #preview { min-height: auto; }
        .iframe-wrapper { position: relative; width: 100%; height: 500px; border-radius: 12px; border: 2px solid var(--primary); box-shadow: 0 0 30px rgba(108, 99, 255, 0.3); overflow: hidden; background: rgba(0, 0, 0, 0.5); }
        .iframe-wrapper iframe { position: relative; z-index: 2; width: 100%; height: 100%; border: none; }
        .iframe-fallback { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1; color: rgba(255, 255, 255, 0.8); font-weight: 500; text-align: center; padding: 20px; }

        .about-content { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center; }
        .about-img img { width: 100%; max-width: 400px; border-radius: 20px; box-shadow: 0 0 30px rgba(233, 69, 96, 0.2); }
        .skills { display: flex; flex-wrap: wrap; gap: 15px; margin-top: 30px; }
        .skill-tag { padding: 10px 20px; display: flex; align-items: center; gap: 10px; font-weight: 500; }
        
        .projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }
        .project-card { padding: 20px; display: flex; flex-direction: column; }
        .project-card img { width: 100%; height: 200px; object-fit: cover; border-radius: 8px; margin-bottom: 20px; }
        .project-card h3 { font-size: 1.5rem; margin-bottom: 10px; }
        .project-card p { color: #aaa; margin-bottom: 20px; flex-grow: 1; }
        .tech-tags { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
        .tech-tags span { font-size: 0.8rem; padding: 4px 10px; background: rgba(108, 99, 255, 0.2); border-radius: 4px; color: #fff; }
        .project-links { display: flex; gap: 15px; }
        .project-links a { flex: 1; text-align: center; }
        
        .contact-wrapper { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; }
        form { display: flex; flex-direction: column; gap: 20px; }
        input, textarea { width: 100%; padding: 15px; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--glass-border); border-radius: 8px; color: white; outline: none; transition: border 0.3s; }
        input:focus, textarea:focus { border-color: var(--primary); }
        textarea { height: 150px; resize: vertical; }
        
        .social-info h3 { margin-bottom: 20px; font-size: 1.8rem; }
        .social-info p { color: #aaa; margin-bottom: 30px; }
        .social-icons { display: flex; gap: 20px; }
        .social-icons a { display: flex; align-items: center; justify-content: center; width: 50px; height: 50px; border-radius: 50%; background: var(--glass-bg); border: 1px solid var(--glass-border); color: var(--text); font-size: 1.2rem; text-decoration: none; transition: all 0.3s; }
        .social-icons a:hover { transform: scale(1.1); background: var(--primary); color: white; border-color: var(--primary); }

        footer { text-align: center; padding: 30px; border-top: 1px solid var(--glass-border); color: #aaa; display: flex; justify-content: center; align-items: center; gap: 10px;}
        .admin-trigger { cursor: pointer; color: #555; transition: 0.3s; }
        .admin-trigger:hover { color: var(--primary); }

        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1000; background: rgba(0,0,0,0.8); backdrop-filter: blur(5px); justify-content: center; align-items: center; padding: 20px; overflow-y: auto; }
        .modal-content { background: var(--bg); border: 1px solid var(--glass-border); border-radius: 16px; padding: 30px 40px; width: 100%; max-width: 500px; position: relative; color: var(--text); }
        .modal-content.large { max-width: 800px; }
        
        /* TOMBOL CLOSE MODAL (X) DIKEMBALIKAN KE SUDUT ATAS KANAN */
        .close-modal { position: absolute; top: 25px; right: 25px; cursor: pointer; font-size: 1.4rem; color: var(--text); z-index: 10; transition: color 0.3s; }
        .close-modal:hover { color: var(--primary); }

        .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 1px solid var(--glass-border); padding-bottom: 15px; padding-right: 30px; }
        .loader { display: none; text-align: center; margin: 20px 0; color: var(--primary); font-weight: bold; }

        @media (max-width: 768px) {
            .hamburger { display: block; z-index: 101; }
            .nav-links { position: fixed; top: 0; right: -100%; width: 100%; height: 100vh; flex-direction: column; justify-content: center; align-items: center; transition: right 0.4s ease; background: var(--bg); }
            .nav-links.active { right: 0; }
            #hero h1 { font-size: 2.5rem; }
            .about-content, .contact-wrapper { grid-template-columns: 1fr; }
            .about-img { order: -1; text-align: center; }
            section { padding: 80px 5%; }
        }
    </style>
</head>
<body>
    <canvas id="particles"></canvas>

    <nav id="navbar">
        <a href="#" class="logo">&lt;Raksyz/&gt;</a>
        <ul class="nav-links">
            <li><a href="#hero">Home</a></li>
            <li><a href="#preview">Preview</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#projects">Projects</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
        <div style="display: flex; align-items: center; gap: 20px;">
            <button id="theme-toggle-btn" class="theme-toggle" aria-label="Toggle Theme"><i class="fas fa-sun"></i></button>
            <div class="hamburger"><i class="fas fa-bars"></i></div>
        </div>
    </nav>

    <section id="hero" class="reveal">
        <h1>Hi, I'm <br><span>Raksyz</span></h1>
        <p>Mr.Fullstack</p>
        <a href="#projects" class="btn">View My Work <i class="fas fa-arrow-right" style="margin-left: 8px;"></i></a>
    </section>

    <section id="preview" class="reveal">
        <h2 class="section-title">🔴 Live <span>Preview</span></h2>
        <div class="iframe-wrapper">
            <div class="iframe-fallback" id="loading-preview">
                <i class="fas fa-spinner fa-spin"></i> Memuat Data Live Preview...
            </div>
            <iframe id="live-preview-frame" src="" title="Live Portfolio Preview"></iframe>
        </div>
    </section>

    <section id="about" class="reveal">
        <h2 class="section-title">About <span>Me</span></h2>
        <div class="about-content">
            <div class="about-text">
                <p>Hello! I'm a passionate web developer with 1 years of experience building scalable, modern, and responsive web applications. I specialize in turning complex problems into beautiful, intuitive interfaces.</p>
                <div class="skills">
                    <div class="glass skill-tag"><i class="fab fa-react"></i> React</div>
                    <div class="glass skill-tag"><i class="fab fa-node-js"></i> Node.js</div>
                    <div class="glass skill-tag"><i class="fas fa-wind"></i> Tailwind</div>
                    <div class="glass skill-tag"><i class="tb tb-brand-nextjs"></i> Next.js</div>
                    <div class="glass skill-tag"><i class="fab fa-js"></i> TypeScript</div>
                </div>
            </div>
            <div class="about-img">
                <img src="logo.png" alt="Profile">
            </div>
        </div>
    </section>

    <section id="projects" class="reveal">
        <h2 class="section-title">My <span>Projects</span></h2>
        <div class="loader" id="projects-loader" style="display: block;">
            <i class="fas fa-spinner fa-spin"></i> Memuat Project dari Database...
        </div>
        <div class="projects-grid" id="dynamic-projects"></div>
    </section>

    <section id="contact" class="reveal">
        <h2 class="section-title">Get in <span>Touch</span></h2>
        <div class="contact-wrapper">
            <div class="social-info">
                <h3>Let's build something awesome together!</h3>
                <p>I'm currently available for freelance work and full-time opportunities.</p>
                <div class="social-icons">
                    <a href="https://github.com/raksyz-porto"><i class="fab fa-github"></i></a>
                    <a href="#"><i class="fab fa-linkedin-in"></i></a>
                    <a href="https://x.com/rkanovian"><i class="fab fa-twitter"></i></a>
                    <a href="mailto:rakanovian200@gmail.com"><i class="fas fa-envelope"></i></a>
                </div>
            </div>
            <form class="glass glass-card" style="padding: 30px;">
                <input type="text" placeholder="Your Name" required>
                <input type="email" placeholder="Your Email" required>
                <textarea placeholder="Your Message" required></textarea>
                <button type="submit" class="btn" style="width: 100%;">Send Message</button>
            </form>
        </div>
    </section>

    <footer>
        <p>&copy; 2026 Raksyz. Made with ❤️</p>
        <i class="fas fa-lock admin-trigger" id="open-admin-login" title="Admin Login"></i>
    </footer>

    <!-- ADMIN MODALS -->
    <div id="loginModal" class="modal">
        <div class="modal-content">
            <i class="fas fa-times close-modal" onclick="closeModal('loginModal')"></i>
            <h2 style="margin-bottom: 20px;">Admin Login</h2>
            <form id="loginForm" onsubmit="handleLogin(event)">
                <input type="email" id="adminEmail" placeholder="Email Supabase" required>
                <input type="password" id="adminPassword" placeholder="Password" required>
                <button type="submit" class="btn">Login</button>
                <p id="loginError" style="color: var(--secondary); margin-top: 10px; display: none;"></p>
            </form>
        </div>
    </div>

    <!-- ADMIN DASHBOARD MODAL DENGAN POSISI LOGOUT YANG AMAN -->
    <div id="adminModal" class="modal">
        <div class="modal-content large">
            <i class="fas fa-times close-modal" onclick="closeModal('adminModal')"></i>
            
            <!-- Header disesuaikan agar tombol Logout rapi dan aman di semua ukuran layar -->
            <div class="admin-header">
                <h2 style="font-size: 1.8rem;">Admin Dashboard</h2>
                <button onclick="handleLogout()" class="btn btn-danger" style="padding: 8px 16px; font-size: 0.9rem;">Logout</button>
            </div>
            
            <div class="loader" id="adminLoader">Menyimpan...</div>

            <div class="glass glass-card" style="padding: 20px; margin-bottom: 30px;">
                <h3>Update Live Preview URL</h3>
                <form onsubmit="updatePreviewLink(event)" style="flex-direction: row; align-items: center; gap: 10px; margin-top: 15px;">
                    <input type="url" id="newPreviewUrl" placeholder="https://..." required>
                    <button type="submit" class="btn" style="white-space: nowrap;">Save Link</button>
                </form>
            </div>

            <div class="glass glass-card" style="padding: 20px;">
                <h3>Tambah Project Baru</h3>
                <form onsubmit="addProject(event)" style="margin-top: 15px;">
                    <input type="text" id="pTitle" placeholder="Judul Project" required>
                    <textarea id="pDesc" placeholder="Deskripsi Singkat" style="height: 80px;" required></textarea>
                    <input type="url" id="pImg" placeholder="URL Gambar Utama" required>
                    <input type="url" id="pDemo" placeholder="Link Demo (https://...)" required>
                    <input type="url" id="pGithub" placeholder="Link Github (https://...)" required>
                    <input type="text" id="pTech" placeholder="Teknologi (pisahkan dengan koma)" required>
                    <button type="submit" class="btn">Tambah Project</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        // KONEKSI SUPABASE
        const SUPABASE_URL = 'https://zlksaomxuqydgegrishx.supabase.co'; 
        const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inpsa3Nhb214dXF5ZGdlZ3Jpc2h4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU5MTU0MzIsImV4cCI6MjEwMTQ5MTQzMn0.J9Dme9YCNR-khP0x2jZQeRaJnkiVDOci1a_xH1Rfmo4';
        
        let dbClient = null;
        let isAdminLoggedIn = false;
        
        try {
            if(window.supabase) {
                dbClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
            }
        } catch (error) {
            console.error("Gagal menginisialisasi Supabase:", error);
        }

        document.addEventListener('DOMContentLoaded', async () => {
            if (dbClient) {
                await fetchSettings();
                await fetchProjects();
                checkAdminSession();
            } else {
                document.getElementById('projects-loader').innerHTML = "Script Supabase gagal dimuat.";
            }
        });

        async function fetchSettings() {
            try {
                const { data, error } = await dbClient.from('settings').select('live_preview_url').eq('id', 1).single();
                if (error) throw error;
                if (data && data.live_preview_url) {
                    document.getElementById('live-preview-frame').src = data.live_preview_url;
                    document.getElementById('loading-preview').style.display = 'none';
                    document.getElementById('newPreviewUrl').value = data.live_preview_url;
                }
            } catch (err) {
                console.error("Error Settings:", err);
                document.getElementById('loading-preview').innerHTML = "<span style='color:var(--secondary)'>Gagal memuat URL Preview.</span>";
            }
        }

        async function fetchProjects() {
            const container = document.getElementById('dynamic-projects');
            const loader = document.getElementById('projects-loader');
            
            try {
                const { data: projects, error } = await dbClient.from('projects').select('*').order('created_at', { ascending: false });
                if (error) throw error;
                
                loader.style.display = 'none';
                container.innerHTML = '';

                if (projects && projects.length > 0) {
                    projects.forEach(project => {
                        const techArr = (project.technologies || "").split(',').map(t => t.trim());
                        const techTags = techArr.map(tech => `<span>${tech}</span>`).join('');
                        
                        const deleteBtn = isAdminLoggedIn ? `<button onclick="deleteProject('${project.id}')" class="btn btn-danger" style="width:100%; margin-top:10px;"><i class="fas fa-trash"></i> Hapus Project</button>` : '';

                        container.innerHTML += `
                            <div class="glass glass-card project-card">
                                <img src="${project.image}" alt="${project.title}">
                                <h3>${project.title}</h3>
                                <p>${project.description}</p>
                                <div class="tech-tags">${techTags}</div>
                                <div class="project-links">
                                    <a href="${project.demo_link}" target="_blank" class="btn btn-outline">Demo</a>
                                    <a href="${project.github_link}" target="_blank" class="btn"><i class="fab fa-github"></i> Code</a>
                                </div>
                                ${deleteBtn}
                            </div>
                        `;
                    });
                } else {
                    container.innerHTML = `<p style="grid-column: 1 / -1; text-align: center; color: #aaa;">Belum ada project. Silakan login sebagai Admin untuk menambah.</p>`;
                }
            } catch (err) {
                console.error("Error Projects:", err);
                loader.innerHTML = "<span style='color:var(--secondary)'>Gagal memuat project dari database.</span>";
            }
        }

        async function checkAdminSession() {
            try {
                const { data: { session } } = await dbClient.auth.getSession();
                if (session) {
                    isAdminLoggedIn = true;
                    document.getElementById('open-admin-login').style.color = 'var(--primary)';
                }
            } catch(e) {}
        }

        document.getElementById('open-admin-login').addEventListener('click', async () => {
            if (!dbClient) return alert("Koneksi Supabase error.");
            const { data: { session } } = await dbClient.auth.getSession();
            if (session) {
                document.getElementById('adminModal').style.display = 'flex';
            } else {
                document.getElementById('loginModal').style.display = 'flex';
            }
        });

        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        async function handleLogin(e) {
            e.preventDefault();
            const email = document.getElementById('adminEmail').value;
            const password = document.getElementById('adminPassword').value;
            const errorMsg = document.getElementById('loginError');
            
            const { data, error } = await dbClient.auth.signInWithPassword({ email, password });
            
            if (error) {
                errorMsg.innerText = error.message;
                errorMsg.style.display = 'block';
            } else {
                isAdminLoggedIn = true;
                closeModal('loginModal');
                document.getElementById('adminModal').style.display = 'flex';
                document.getElementById('loginForm').reset();
                fetchProjects();
            }
        }

        async function handleLogout() {
            await dbClient.auth.signOut();
            isAdminLoggedIn = false;
            closeModal('adminModal');
            alert("Logout berhasil!");
            fetchProjects(); 
        }

        function showLoader(show) { document.getElementById('adminLoader').style.display = show ? 'block' : 'none'; }

        async function updatePreviewLink(e) {
            e.preventDefault();
            showLoader(true);
            const newUrl = document.getElementById('newPreviewUrl').value;
            const { error } = await dbClient.from('settings').update({ live_preview_url: newUrl }).eq('id', 1);
            showLoader(false);
            if(error) alert("Gagal update link: " + error.message);
            else { alert("Preview URL berhasil diupdate!"); fetchSettings(); }
        }

        async function addProject(e) {
            e.preventDefault();
            showLoader(true);
            const newProj = {
                title: document.getElementById('pTitle').value,
                description: document.getElementById('pDesc').value,
                image: document.getElementById('pImg').value,
                demo_link: document.getElementById('pDemo').value,
                github_link: document.getElementById('pGithub').value,
                technologies: document.getElementById('pTech').value
            };
            const { error } = await dbClient.from('projects').insert([newProj]);
            showLoader(false);
            if(error) alert("Gagal tambah project: " + error.message);
            else { alert("Project berhasil ditambahkan!"); e.target.reset(); fetchProjects(); }
        }

        async function deleteProject(id) {
            if(confirm("Yakin ingin menghapus project ini?")) {
                const { error } = await dbClient.from('projects').delete().eq('id', id);
                if(error) alert("Gagal hapus: " + error.message);
                else fetchProjects();
            }
        }

        const themeToggleBtn = document.getElementById('theme-toggle-btn');
        if(themeToggleBtn) {
            themeToggleBtn.addEventListener('click', () => {
                document.body.classList.toggle('light-mode');
                themeToggleBtn.querySelector('i').className = document.body.classList.contains('light-mode') ? 'fas fa-moon' : 'fas fa-sun';
            });
        }

        const hamburger = document.querySelector('.hamburger');
        const navLinks = document.querySelector('.nav-links');
        if(hamburger) {
            hamburger.addEventListener('click', () => {
                navLinks.classList.toggle('active');
                hamburger.querySelector('i').className = navLinks.classList.contains('active') ? 'fas fa-times' : 'fas fa-bars';
            });
        }

        window.addEventListener('scroll', () => {
            document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 50);
        });

        const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.remove('start');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.1 });
        
        document.querySelectorAll('.reveal').forEach(el => {
            el.classList.add('start');
            revealObserver.observe(el);
        });

        const canvas = document.getElementById('particles');
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth; canvas.height = window.innerHeight;
        let particlesArray = [];
        class Particle {
            constructor() {
                this.x = Math.random() * canvas.width; this.y = Math.random() * canvas.height;
                this.size = Math.random() * 2; this.speedX = Math.random() * 1 - 0.5; this.speedY = Math.random() * 1 - 0.5;
            }
            update() {
                this.x += this.speedX; this.y += this.speedY;
                if (this.x < 0 || this.x > canvas.width) this.speedX *= -1;
                if (this.y < 0 || this.y > canvas.height) this.speedY *= -1;
            }
            draw() {
                const isLight = document.body.classList.contains('light-mode');
                ctx.fillStyle = isLight ? `rgba(108, 99, 255, ${Math.random() * 0.3 + 0.1})` : `rgba(108, 99, 255, ${Math.random() * 0.5 + 0.1})`;
                ctx.beginPath(); ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2); ctx.fill();
            }
        }
        function init() {
            particlesArray = [];
            for (let i = 0; i < (canvas.width * canvas.height) / 9000; i++) particlesArray.push(new Particle());
        }
        function animate() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particlesArray.forEach(p => { p.update(); p.draw(); });
            requestAnimationFrame(animate);
        }
        init(); animate();
        window.addEventListener('resize', () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; init(); });
    </script>
</body>
</html>